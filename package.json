{
  "name": "advi-ui",
  "version": "0.5.0",
  "description": "Personal React component library built on shadcn/ui + Tailwind CSS",
  "repository": {
    "type": "git",
    "url": "https://github.com/1atharvad/advi-ui"
  },
  "type": "module",
  "main": "./dist/advi-ui.cjs.js",
  "module": "./dist/advi-ui.es.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/advi-ui.es.js",
      "require": "./dist/advi-ui.cjs.js"
    },
    "./styles": {
      "types": "./dist/advi-ui.css.d.ts",
      "default": "./dist/advi-ui.css"
    },
    "./base": {
      "types": "./dist/base.css.d.ts",
      "default": "./dist/base.css"
    },
    "./theme/default": {
      "types": "./dist/theme-default.css.d.ts",
      "default": "./dist/theme/default.css"
    },
    "./theme/midnight": {
      "types": "./dist/theme-midnight.css.d.ts",
      "default": "./dist/theme/midnight.css"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -b && vite build --mode production && vite build --mode production --config vite.styles.config.ts && node scripts/build-fonts.mjs && node scripts/write-css-type-stubs.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/format-changelog-dates.mjs",
    "release": "npm run build:lib && changeset publish",
    "size": "npm run build:lib && size-limit"
  },
  "size-limit": [
    {
      "name": "advi-ui.es.js",
      "path": "dist/advi-ui.es.js",
      "limit": "80 KB"
    },
    {
      "name": "advi-ui.css",
      "path": "dist/advi-ui.css",
      "limit": "20 KB"
    },
    {
      "name": "base.css",
      "path": "dist/base.css",
      "limit": "20 KB"
    },
    {
      "name": "fonts.css",
      "path": "dist/fonts.css",
      "limit": "10 KB"
    }
  ],
  "peerDependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.8.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource/raleway": "^5.2.8",
    "@fontsource/rubik": "^5.2.8",
    "@fontsource/unbounded": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@size-limit/file": "^12.1.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^17.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.8.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.99.0",
    "size-limit": "^12.1.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  }
}
